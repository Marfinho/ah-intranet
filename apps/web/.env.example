API_URL=http://localhost:3001/api

# Nur für die Mehrmandanten-Plattform gesetzt (siehe docs/plattform.md): die
# Adresse des Betreibers ohne Subdomain, z. B. "ahoi.online". Nur auf dieser
# Adresse zeigt "/" die öffentliche Produktseite statt eines
# Anmeldeformulars ohne Mandant. Leer lassen bei einer Einzelinstallation.
NEXT_PUBLIC_BASE_DOMAIN=
