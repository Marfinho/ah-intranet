{
  "name": "api",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ah-intranet/shared build && nest start --watch",
    "build": "pnpm --filter @ah-intranet/shared build && nest build",
    "start": "node dist/main",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate && tsx prisma/modell-meta.ts",
    "prisma:migrate": "prisma migrate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:einrichten": "tsx prisma/einrichten.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "aufbewahrung": "node dist/scripts/aufbewahrung.js",
    "aufbewahrung:vorschau": "node dist/scripts/aufbewahrung.js --vorschau",
    "anonymisieren": "node dist/scripts/anonymisieren.js"
  },
  "dependencies": {
    "@ah-intranet/shared": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
