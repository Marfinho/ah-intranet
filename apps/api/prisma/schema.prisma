  @@unique([tenantId, templateId, userId])
  @@index([tenantId])
}

model OnboardingItem {
  id           String    @id @default(cuid())
  tenantId     String    @default("")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignmentId String
  stepId       String
  done         Boolean   @default(false)
  doneAt       DateTime?
  note         String?

  assignment OnboardingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  step       OnboardingStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([tenantId, assignmentId, stepId])
  @@index([tenantId])
}

