// --------------------------------------------------------- Onboarding

model OnboardingTemplate {
  id            String   @id @default(cuid())
  tenantId      String   @default("")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  targetRole    String
  durationLabel String
