// ------------------------------------------------------ Schnittstellen

enum SyncRunStatus {
  running
  succeeded
  failed
}

enum SyncDirection {
  inbound
  outbound
}

/// Laufzeitzustand eines Konnektors. Die fachliche Definition steht in der
/// Registry in @ah-intranet/shared; hier liegen nur Konfiguration und Status.

/// Protokoll jedes Synchronisationslaufs - auch der fehlgeschlagenen.

/// Zuordnung interner Datensätze zu ihren Gegenstücken im Fremdsystem.

/// Aus Fremdsystemen übernommener Fahrzeugbestand. Lesend gepflegt: die
/// führenden Daten bleiben im DMS bzw. in der Börse.

// ===== Schichtplan =====

/// Zustand eines Tauschvorgangs.
///
/// Zwei Stufen mit Absicht: erst muss die andere Person zustimmen, dann die
/// Führungskraft freigeben. Eine einzige Freigabe würde entweder jemandem eine
/// Schicht aufdrücken oder die Besetzung an der Leitung vorbei ändern.
enum ShiftSwapStatus {
  offen
  angenommen
  freigegeben
  abgelehnt
  zurueckgezogen
}

/// Eine Schicht: ein Zeitraum an einem Ort, besetzt oder offen.
model Shift {
  id           String      @id @default(cuid())
  tenantId     String      @default("")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Klartext wie "Frühdienst Serviceannahme".
  label        String
  startsAt     DateTime
  endsAt       DateTime
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Offen, solange niemand eingeteilt ist.
  assigneeId   String?
  assignee     User?       @relation("ShiftAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  note         String?
  createdById  String
  createdBy    User        @relation("ShiftCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  swaps ShiftSwap[]

  @@index([tenantId, startsAt])
  @@index([assigneeId])
}

/// Ein Tauschvorgang zu genau einer Schicht.
model ShiftSwap {
  id           String          @id @default(cuid())
  tenantId     String          @default("")
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shiftId      String
  shift        Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// Wer abgeben möchte - zum Zeitpunkt der Anfrage die eingeteilte Person.
  requesterId  String
  requester    User            @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Wer übernehmen soll.
  targetId     String
  target       User            @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status       ShiftSwapStatus @default(offen)
  note         String?
  /// Antwort der angefragten Person, unabhängig von der Freigabe.
  respondedAt  DateTime?
  decidedById  String?
  decidedBy    User?           @relation("SwapDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([shiftId])
  @@index([targetId])
}

// ===== Fundsachen und Schlüssel =====

enum CustodyKind {
  fundsache
  schluessel
}

/// Wo sich der Gegenstand gerade befindet.
enum CustodyStatus {
  verwahrt
  ausgegeben
  abgeholt
  entsorgt
}

enum CustodyEventKind {
  aufgenommen
  ausgegeben
  zurueckgenommen
  abgeholt
  entsorgt
}

/// Ein verwahrter Gegenstand: ein Fund oder ein Schlüssel.
model CustodyItem {
  id           String        @id @default(cuid())
  tenantId     String        @default("")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         CustodyKind
  title        String
  description  String?
  /// Wo der Gegenstand liegt, wenn er verwahrt ist - "Tresor Empfang".
  storagePlace String?
  locationId   String?
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status       CustodyStatus @default(verwahrt)
  /// Wer ihn gerade hat, solange er ausgegeben ist.
  holderId     String?
  holder       User?         @relation("CustodyHolder", fields: [holderId], references: [id], onDelete: SetNull)
  /// Nur bei Fundsachen: wann und wo gefunden.
  foundAt      DateTime?
  foundPlace   String?
  createdById  String
  createdBy    User          @relation("CustodyCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events CustodyEvent[]

  @@index([tenantId, status])
  @@index([holderId])
}

/// Jede Bewegung mit handelnder Person und Zeitstempel.
///
/// Der Verlauf ist der eigentliche Zweck des Moduls: "wer hat den Schlüssel"
/// beantwortet der Zustand, "wer hatte ihn im März" nur die Kette.
model CustodyEvent {
  id         String           @id @default(cuid())
  tenantId   String           @default("")
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId     String
  item       CustodyItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind       CustodyEventKind
  /// Die Person, die übernimmt oder abholt - nicht die buchende.
  personId   String?
  person     User?            @relation("CustodyPerson", fields: [personId], references: [id], onDelete: SetNull)
  personName String?
  note       String?
  actorId    String
  actor      User             @relation("CustodyActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([tenantId, itemId])
}

// ===== Essensbestellung =====

/// Das Angebot eines Tages an einem Standort.
model MealOffer {
  id            String    @id @default(cuid())
  tenantId      String    @default("")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  provider      String
  /// Bis wann bestellt werden kann. Danach nimmt die Sammelliste nichts mehr an.
  orderDeadline DateTime
  locationId    String?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  note          String?
  createdById   String
  createdBy     User      @relation("MealCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  options MealOption[]
  orders  MealOrder[]

  @@index([tenantId, date])
}

model MealOption {
  id          String    @id @default(cuid())
  tenantId    String    @default("")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId     String
  offer       MealOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// In Cent, damit nichts gerundet wird.
  priceCents  Int

  orders MealOrder[]

  @@index([tenantId, offerId])
}

/// Eine Bestellung je Person und Angebot.
model MealOrder {
  id        String     @id @default(cuid())
  tenantId  String     @default("")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId   String
  offer     MealOffer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  optionId  String
  option    MealOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("MealOrderUser", fields: [userId], references: [id], onDelete: Cascade)
  quantity  Int        @default(1)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Eine Bestellung je Person und Tag; ändern statt doppelt anlegen.
  @@unique([tenantId, offerId, userId])
  @@index([tenantId, offerId])
}

/// Einmaltoken zum Zurücksetzen eines vergessenen Passworts.
///
/// Gespeichert wird nur der Hash: ein Datenbankabzug darf niemandem den Zugang
/// zu einem Konto eröffnen. Der Klartext steht ausschließlich in der E-Mail.
model PasswordReset {
  id        String    @id @default(cuid())
  tenantId  String    @default("")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 des Tokens aus der E-Mail.
  tokenHash String    @unique
  expiresAt DateTime
  /// Gesetzt, sobald der Token benutzt wurde - ein zweiter Versuch scheitert.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
}
