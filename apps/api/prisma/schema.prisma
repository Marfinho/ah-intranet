generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum UserStatus {
  active
  inactive
  /// Auf Verlangen der Person anonymisiert. Das Konto bleibt als Anker für
  /// aufbewahrungspflichtige Vorgänge bestehen, trägt aber keine Identität mehr.
  deleted
}

enum Presence {
  vor_ort
  mobil
  abwesend
}

enum RoleScopeType {
  global
  location
  department
  specialty_area
}

enum NewsStatus {
  draft
  published
  archived
}

enum Priority {
  niedrig
  normal
  hoch
  kritisch
}

enum OrderType {
  business_card
  workwear
}

enum OrderStatus {
  draft
  submitted
  approved
  rejected
  queued_for_bulk_order
  ordered
  completed
  cancelled
}

enum ApprovalDecisionType {
  approved
  rejected
}

enum CycleType {
  business_cards
  workwear
}

enum AttachmentType {
  image
  pdf
  file
}

enum DocumentFileType {
  pdf
  docx
  xlsx
  link
}

enum CalendarCategory {
  schulung
  aktion
  wartung
  meeting
  bestellung
}

enum TicketCategory {
  it
  facility
  hr
  marketing
}

enum TicketStatus {
  offen
  in_bearbeitung
  wartet_auf_rueckmeldung
  geloest
}

enum AbsenceType {
  urlaub
  krank
  gleitzeit
  sonderurlaub
  fortbildung
}

enum AbsenceStatus {
  submitted
  approved
  rejected
  cancelled
}

enum IdeaStatus {
  neu
  in_pruefung
  angenommen
  umgesetzt
  abgelehnt
}

enum NotificationChannel {
  in_app
  email
}

// ------------------------------------------------------------ Mandanten

/// Ein Autohaus als Mandant. Sämtliche Fachdaten hängen daran; das Löschen
/// eines Mandanten entfernt über die Kaskade auch seine Daten.
model Tenant {
  id        String   @id @default(cuid())
  /// Kurzkennung, auch als Subdomain verwendbar.
  slug      String   @unique
  name      String
  /// Eigene Domain, falls der Mandant nicht über die Subdomain kommt.
  domain    String?  @unique
  isActive  Boolean  @default(true)
  notes     String?
  /// Data-URL (PNG/SVG/JPEG, serverseitig auf 200 KB begrenzt). Tritt in der
  /// Kopfzeile an die Stelle der Wortmarke "AHOI" - ohne Logo bleibt es dabei.
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations                    Location[]
  departments                  Department[]
  specialtyAreas               SpecialtyArea[]
  locationDepartments          LocationDepartment[]
  users                        User[]
  roles                        Role[]
  permissions                  Permission[]
  userRoles                    UserRole[]
  rolePermissions              RolePermission[]
  moduleSettings               ModuleSetting[]
  newsPosts                    NewsPost[]
  newsAttachments              NewsAttachment[]
  newsComments                 NewsComment[]
  newsReads                    NewsRead[]
  orders                       Order[]
  orderStatusHistorys          OrderStatusHistory[]
  orderComments                OrderComment[]
  businessCardFieldDefinitions BusinessCardFieldDefinition[]
  businessCardOrders           BusinessCardOrder[]
  businessCardOrderFields      BusinessCardOrderField[]
  workwearCatalogItems         WorkwearCatalogItem[]
  workwearItemSizes            WorkwearItemSize[]
  workwearOrders               WorkwearOrder[]
  workwearOrderItems           WorkwearOrderItem[]
  approvalRules                ApprovalRule[]
  approvalDecisions            ApprovalDecision[]
  orderCycles                  OrderCycle[]
  documents                    Document[]
  wikiArticles                 WikiArticle[]
  calendarEvents               CalendarEvent[]
  rooms                        Room[]
  roomBookings                 RoomBooking[]
  tickets                      Ticket[]
  ticketComments               TicketComment[]
  onboardingTemplates          OnboardingTemplate[]
  onboardingSteps              OnboardingStep[]
  onboardingAssignments        OnboardingAssignment[]
  onboardingItems              OnboardingItem[]
  absences                     Absence[]
  ideas                        Idea[]
  ideaVotes                    IdeaVote[]
  polls                        Poll[]
  pollOptions                  PollOption[]
  pollVotes                    PollVote[]
  quickLinks                   QuickLink[]
  notifications                Notification[]
  auditLogs                    AuditLog[]
  authProviders                TenantAuthProvider[]
  passwordResets               PasswordReset[]
  shifts                       Shift[]
  shiftSwaps                   ShiftSwap[]
  custodyItems                 CustodyItem[]
  custodyEvents                CustodyEvent[]
  mealOffers                   MealOffer[]
  mealOptions                  MealOption[]
  mealOrders                   MealOrder[]

  @@index([isActive])
}

/// Art einer Anmeldung. `password` ist immer da und steht nicht in dieser Tabelle.
enum AuthProviderKind {
  entra
}

/// Zusätzliche Anmeldeart eines Hauses.
///
/// Das Passwort bleibt der Grundweg: damit startet jedes Haus ohne Vorbedingung
/// und der Monteur kommt auch vom privaten Telefon in der Halle hinein. Wer
/// Microsoft Entra ID einsetzt, hinterlegt es hier zusätzlich.
///
/// `isActive` schaltet die Anmeldeart im Anmeldeformular frei. Solange der
/// Austausch mit dem Anbieter nicht gebaut ist, bleibt sie aus - ein Knopf, der
/// nichts tut, wäre schlimmer als keiner.
model TenantAuthProvider {
  id           String           @id @default(cuid())
  tenantId     String           @default("")
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         AuthProviderKind
  /// Beschriftung im Anmeldeformular, z. B. "Anmeldung mit dem Firmenkonto".
  label        String
  /// Verzeichnis beim Anbieter (bei Entra: die Verzeichnis-ID des Hauses).
  directory    String
  clientId     String
  /// Verschlüsselt (AES-256-GCM); verlässt die API nie.
  clientSecret String?
  isActive     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([tenantId, kind])
  @@index([tenantId])
}

// ------------------------------------------------------- Organisation

model Location {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  orderCycles         OrderCycle[]
  locationDepartments LocationDepartment[]
  rooms               Room[]
  shifts              Shift[]
  custodyItems        CustodyItem[]
  mealOffers          MealOffer[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  locationDepartments LocationDepartment[]
  shifts              Shift[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model SpecialtyArea {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model LocationDepartment {
  id           String   @id @default(cuid())
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId   String
  departmentId String
  createdAt    DateTime @default(now())

  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, departmentId])
  @@index([tenantId])
}

// -------------------------------------------------- Benutzer & Rechte

model User {
  id                 String     @id @default(cuid())
  tenantId           String     @default("")
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  username           String
  email              String?
  passwordHash       String
  firstName          String
  lastName           String
  jobTitle           String     @default("Mitarbeitende:r")
  phone              String?
  mobile             String?
  presence           Presence   @default(vor_ort)
  responsibilities   String[]   @default([])
  status             UserStatus @default(active)
  /// Zielgruppen-Tokens (global, location:*, department:*, specialty:*) - bei Stammdatenänderung neu berechnet.
  scopes             String[]   @default([])
  annualLeaveDays    Int        @default(30)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  /// Zeitpunkt der Anonymisierung nach Art. 17 DSGVO. Gesetzt heißt: die
  /// identifizierenden Felder sind ersetzt, der Vorgangsbezug bleibt erhalten.
  anonymizedAt       DateTime?
  /// Darf Mandanten anlegen und sperren - betrifft alle Häuser, nicht nur das eigene.
  isPlatformAdmin    Boolean    @default(false)
  /// Wird bei Sperre und Passwortwechsel erhöht und macht alle bis dahin
  /// ausgegebenen Tokens sofort ungültig.
  tokenVersion       Int        @default(0)
  failedLoginCount   Int        @default(0)
  /// Gesetzt, solange das Konto nach zu vielen Fehlversuchen gesperrt ist.
  lockedUntil        DateTime?
  /// Objekt-ID des verknüpften Kontos in Microsoft Entra ID. Verknüpft wird
  /// beim ersten Anmelden über Entra, anhand der E-Mail-Adresse - danach
  /// entscheidet nur noch diese ID, nicht mehr die (änderbare) E-Mail-Adresse.
  entraObjectId      String?
  /// Verschlüsselt (AES-256-GCM); für den lesenden Zugriff auf den
  /// Outlook-Kalender. Verlässt die API nie im Klartext.
  msRefreshToken     String?
  msTokenUpdatedAt   DateTime?
  locationId         String?
  departmentId       String?
  specialtyAreaId    String?
  managerId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  location      Location?      @relation(fields: [locationId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  specialtyArea SpecialtyArea? @relation(fields: [specialtyAreaId], references: [id])
  manager       User?          @relation("ManagerRelation", fields: [managerId], references: [id])
  reports       User[]         @relation("ManagerRelation")

  roles             UserRole[]
  newsPosts         NewsPost[]             @relation("NewsAuthor")
  newsComments      NewsComment[]
  newsReads         NewsRead[]
  orders            Order[]                @relation("OrderRequester")
  orderComments     OrderComment[]
  approvalDecisions ApprovalDecision[]     @relation("ApprovalActor")
  auditLogs         AuditLog[]             @relation("AuditActor")
  notifications     Notification[]
  documents         Document[]             @relation("DocumentOwner")
  events            CalendarEvent[]        @relation("EventOrganizer")
  ticketsRequested  Ticket[]               @relation("TicketRequester")
  ticketsAssigned   Ticket[]               @relation("TicketAssignee")
  ticketComments    TicketComment[]
  onboarding        OnboardingAssignment[] @relation("OnboardingEmployee")
  absences          Absence[]              @relation("AbsenceEmployee")
  absenceDecisions  Absence[]              @relation("AbsenceDecider")
  roomBookings      RoomBooking[]
  wikiArticles      WikiArticle[]          @relation("WikiAuthor")
  ideas             Idea[]                 @relation("IdeaAuthor")
  ideaVotes         IdeaVote[]
  polls             Poll[]                 @relation("PollAuthor")
  pollVotes         PollVote[]
  shiftsAssigned    Shift[]                @relation("ShiftAssignee")
  shiftsCreated     Shift[]                @relation("ShiftCreator")
  swapsRequested    ShiftSwap[]            @relation("SwapRequester")
  swapsReceived     ShiftSwap[]            @relation("SwapTarget")
  swapsDecided      ShiftSwap[]            @relation("SwapDecider")
  custodyHeld       CustodyItem[]          @relation("CustodyHolder")
  custodyCreated    CustodyItem[]          @relation("CustodyCreator")
  custodyReceived   CustodyEvent[]         @relation("CustodyPerson")
  custodyBooked     CustodyEvent[]         @relation("CustodyActor")
  mealOffersMade    MealOffer[]            @relation("MealCreator")
  mealOrders        MealOrder[]            @relation("MealOrderUser")
  passwordResets    PasswordReset[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@unique([tenantId, entraObjectId])
  @@index([status])
  @@index([locationId, departmentId])
  @@index([tenantId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String   @default("")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String
  /// Rangfolge: höher schlägt niedriger bei der Bestimmung der Hauptrolle.
  rank        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  tenantId    String   @default("")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model UserRole {
  id                   String        @id @default(cuid())
  tenantId             String        @default("")
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId               String
  roleId               String
  scopeType            RoleScopeType @default(global)
  scopeLocationId      String?
  scopeDepartmentId    String?
  scopeSpecialtyAreaId String?
  createdAt            DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId, scopeType, scopeLocationId, scopeDepartmentId, scopeSpecialtyAreaId])
  @@index([userId])
  @@index([tenantId])
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String   @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
}

// ------------------------------------------------------ Modulsteuerung

/// Feature-Toggle je Modul. Schlüssel stammen aus der Registry in @ah-intranet/shared.
model ModuleSetting {
  key       String
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([tenantId, key])
  @@index([tenantId])
}

// -------------------------------------------------------------- News

model NewsPost {
  id             String     @id @default(cuid())
  tenantId       String     @default("")
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug           String
  title          String
  teaser         String
  content        String
  priority       Priority   @default(normal)
  status         NewsStatus @default(draft)
  pinned         Boolean    @default(false)
  audienceScopes String[]   @default(["global"])
  publishedAt    DateTime?
  expiresAt      DateTime?
  authorId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  author      User             @relation("NewsAuthor", fields: [authorId], references: [id])
  attachments NewsAttachment[]
  comments    NewsComment[]
  reads       NewsRead[]

  @@unique([tenantId, slug])
  @@index([status, publishedAt])
  @@index([audienceScopes], type: Gin)
  @@index([tenantId])
}

model NewsAttachment {
  id         String         @id @default(cuid())
  tenantId   String         @default("")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  newsPostId String
  fileName   String
  mimeType   String
  url        String
  type       AttachmentType
  createdAt  DateTime       @default(now())

  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NewsComment {
  id         String   @id @default(cuid())
  tenantId   String   @default("")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  newsPostId String
  authorId   String
  message    String
  createdAt  DateTime @default(now())

  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([newsPostId])
  @@index([tenantId])
}

model NewsRead {
  id         String   @id @default(cuid())
  tenantId   String   @default("")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  newsPostId String
  userId     String
  readAt     DateTime @default(now())

  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, newsPostId, userId])
  @@index([userId])
  @@index([tenantId])
}

// ------------------------------------------------------- Bestellungen

model Order {
  id              String      @id @default(cuid())
  tenantId        String      @default("")
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber     String
  type            OrderType
  requesterId     String
  status          OrderStatus @default(draft)
  orderCycleId    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  orderedAt       DateTime?
  completedAt     DateTime?
  /// Rechnungsbetrag des externen Dienstleisters, Grundlage für den DATEV-Export.
  netAmount       Decimal?    @db.Decimal(12, 2)
  supplierInvoice String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  requester         User                 @relation("OrderRequester", fields: [requesterId], references: [id])
  orderCycle        OrderCycle?          @relation(fields: [orderCycleId], references: [id])
  statusHistory     OrderStatusHistory[]
  comments          OrderComment[]
  businessCardOrder BusinessCardOrder?
  workwearOrder     WorkwearOrder?
  approvalDecisions ApprovalDecision[]

  @@unique([tenantId, orderNumber])
  @@index([status, createdAt])
  @@index([requesterId])
  @@index([tenantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  tenantId  String      @default("")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  note      String?
  actorName String?
  changedAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
}

model OrderComment {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  authorId  String
  message   String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
}

model BusinessCardFieldDefinition {
  id         String   @id @default(cuid())
  tenantId   String   @default("")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key        String
  label      String
  fieldType  String
  sortOrder  Int
  isRequired Boolean  @default(false)
  isActive   Boolean  @default(true)
  options    String[] @default([])
  helpText   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values BusinessCardOrderField[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model BusinessCardOrder {
  id            String   @id @default(cuid())
  tenantId      String   @default("")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  quantity      Int      @default(100)
  reorderFromId String?
  createdAt     DateTime @default(now())

  order       Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reorderFrom BusinessCardOrder?       @relation("BusinessCardReorder", fields: [reorderFromId], references: [id])
  reorders    BusinessCardOrder[]      @relation("BusinessCardReorder")
  fields      BusinessCardOrderField[]

  @@index([tenantId])
}

model BusinessCardOrderField {
  id                  String   @id @default(cuid())
  tenantId            String   @default("")
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessCardOrderId String
  fieldDefinitionId   String
  value               String
  createdAt           DateTime @default(now())

  businessCardOrder BusinessCardOrder           @relation(fields: [businessCardOrderId], references: [id], onDelete: Cascade)
  fieldDefinition   BusinessCardFieldDefinition @relation(fields: [fieldDefinitionId], references: [id])

  @@index([businessCardOrderId])
  @@index([tenantId])
}

model WorkwearCatalogItem {
  id          String   @id @default(cuid())
  tenantId    String   @default("")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sizes      WorkwearItemSize[]
  orderItems WorkwearOrderItem[]

  @@index([tenantId])
}

model WorkwearItemSize {
  id            String   @id @default(cuid())
  tenantId      String   @default("")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItemId String
  sizeLabel     String
  sortOrder     Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  catalogItem WorkwearCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, catalogItemId, sizeLabel])
  @@index([tenantId])
}

model WorkwearOrder {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  createdAt DateTime @default(now())

  order Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items WorkwearOrderItem[]

  @@index([tenantId])
}

model WorkwearOrderItem {
  id              String   @id @default(cuid())
  tenantId        String   @default("")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workwearOrderId String
  catalogItemId   String
  sizeLabel       String
  quantity        Int
  createdAt       DateTime @default(now())

  workwearOrder WorkwearOrder       @relation(fields: [workwearOrderId], references: [id], onDelete: Cascade)
  catalogItem   WorkwearCatalogItem @relation(fields: [catalogItemId], references: [id])

  @@index([workwearOrderId])
  @@index([tenantId])
}

model ApprovalRule {
  id              String        @id @default(cuid())
  tenantId        String        @default("")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderType       OrderType
  scopeType       RoleScopeType @default(global)
  locationId      String?
  departmentId    String?
  specialtyAreaId String?
  roleKey         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
}

model ApprovalDecision {
  id        String               @id @default(cuid())
  tenantId  String               @default("")
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  actorId   String
  decision  ApprovalDecisionType
  note      String?
  decidedAt DateTime             @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User  @relation("ApprovalActor", fields: [actorId], references: [id])

  @@index([orderId])
  @@index([tenantId])
}

model OrderCycle {
  id            String    @id @default(cuid())
  tenantId      String    @default("")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycleType     CycleType
  title         String
  nextOrderDate DateTime
  locationId    String?
  notes         String?
