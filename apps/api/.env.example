PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ah_intranet?schema=public
FRONTEND_URL=http://localhost:3000
# In Produktion zwingend durch einen langen Zufallswert ersetzen.
JWT_SECRET=bitte-aendern-langer-zufallswert

# Verschlüsselt hinterlegte Geheimnisse (z. B. den Clientschlüssel des
# Identitätsanbieters). Getrennt von der Datensicherung aufbewahren - ohne ihn
# sind die Geheimnisse nach einer Wiederherstellung unlesbar.
SECRET_KEY=bitte-aendern-langer-zufallswert
JWT_EXPIRES_IN=12h
