PORT=3002
# Datenbank der Kundenhäuser. In Produktion die eingeschränkte Rolle aus
# scripts/verwaltung-rolle.sql verwenden, nicht den Datenbankbesitzer.
INTRANET_DATABASE_URL=postgresql://ahoi_verwaltung:bitte-aendern@localhost:5432/ah_intranet?schema=public
# Eigene Daten der Verwaltung (Betreiberkonten, Protokoll, Verlauf). Dieselbe
# Datenbank, eigenes Schema - mit Besitzerrechten, damit Migrationen laufen.
VERWALTUNG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ah_intranet?schema=verwaltung
# Eigener Schlüssel, NICHT der JWT_SECRET der Kunden-API: Sitzungen beider
# Systeme dürfen nicht austauschbar sein.
VERWALTUNG_JWT_SECRET=bitte-aendern-langer-zufallswert
# Verschlüsselt den zweiten Faktor. Pflicht, sonst lässt sich kein Konto einrichten.
SECRET_KEY=bitte-aendern-langer-zufallswert
# Optional: Zustand der Kunden-API im Systemstatus
INTRANET_API_URL=http://localhost:3001/api
BASE_DOMAIN=
# Adresse der Pitch-Seite im Betreiber-Mandanten der Kunden-Anwendung; daraus entstehen die Links für Interessenten.
PITCH_BASIS_URL=http://verwaltung.localhost:3000
# Optional: Verzeichnis der Sicherungen (read-only einbinden), zeigt das Alter der letzten
# SICHERUNG_VERZEICHNIS=
# Aktualisierung von GitHub: Repository und, nur bei einem privaten, ein Lesetoken.
# GITHUB_REPO=Marfinho/ah-intranet
# GITHUB_TOKEN=
