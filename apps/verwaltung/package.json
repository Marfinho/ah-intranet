{
  "name": "verwaltung",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ah-intranet/shared build && nest start --watch",
    "build": "pnpm --filter @ah-intranet/shared build && nest build",
    "start": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "betreiber:anlegen": "tsx src/scripts/betreiber-anlegen.ts",
    "schnappschuss": "node dist/scripts/schnappschuss.js",
    "pruefung:rolle": "node dist/scripts/pruefung-rolle.js"
  },
  "dependencies": {
    "@ah-intranet/shared": "workspace:*",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.11.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.1"
  }
}
