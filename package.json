{
  "name": "ah-intranet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @ah-intranet/shared build && pnpm -r --parallel --filter @ah-intranet/shared --filter api --filter web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "seed": "pnpm --filter api prisma:seed",
    "migrate": "pnpm --filter api prisma:migrate",
    "e2e": "node e2e/smoke.js && node e2e/flows.js",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": "^4.18.1",
      "multer@<2.3.0": "^2.3.1",
      "postcss@<8.5.18": "^8.5.18"
    }
  }
}
